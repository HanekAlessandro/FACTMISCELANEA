<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Miscelánea Master</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Estilos del sitio -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FactMiscelanea.styles.css" asp-append-version="true" />
    
    <style>
        body {
            padding-top: 70px;
            font-family: 'Poppins', sans-serif;
        }
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
        }
        .brand-text {
            background: linear-gradient(135deg, #fff 0%, #e0e0e0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .nav-link {
            font-weight: 500;
            transition: all 0.3s;
        }
        .nav-link:hover {
            transform: translateY(-2px);
        }
        .footer {
            background: #f8f9fa;
            padding: 20px 0;
            margin-top: 50px;
            border-top: 1px solid #e9ecef;
        }
        .main-content {
            min-height: calc(100vh - 140px);
        }
        .user-name {
            font-weight: 600;
        }
        .btn-logout {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.8);
            transition: all 0.3s;
        }
        .btn-logout:hover {
            color: white;
            transform: translateY(-2px);
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="container-scroller">
        <!-- Navbar mejorada -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary fixed-top">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-store me-2"></i>
                    <span class="brand-text">Miscelánea Master</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Menú visible SOLO cuando el usuario ha iniciado sesión -->
                    @if (Context.Session.GetInt32("UsuarioId") != null)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="/Productos">
                                    <i class="fas fa-boxes me-1"></i> Productos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Clientes">
                                    <i class="fas fa-users me-1"></i> Clientes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Facturas">
                                    <i class="fas fa-file-invoice me-1"></i> Facturas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Reportes">
                                    <i class="fas fa-chart-line me-1"></i> Reportes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Logout">
                                    <i class="fas fa-sign-out-alt me-1"></i>
                                    <span class="user-name">@Context.Session.GetString("UsuarioNombre")</span>
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Menú para usuarios NO logueados -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">
                                    <i class="fas fa-sign-in-alt me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Register">
                                    <i class="fas fa-user-plus me-1"></i> Registrarse
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <span>&copy; 2026 - <strong>Miscelánea Master</strong> - Sistema de Facturación</span>
                    </div>
                    <div class="col-md-6 text-end">
                        <span>Versión 1.0 | Desarrollado por Hanek Alessandro</span>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        // Auto-cerrar alertas después de 5 segundos
        $(document).ready(function() {
            setTimeout(function() {
                $(".alert").fadeOut("slow", function() {
                    $(this).remove();
                });
            }, 5000);
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>