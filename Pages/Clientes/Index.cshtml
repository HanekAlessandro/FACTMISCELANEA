@page
@model FactMiscelanea.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Clientes/index.css" />
</head>
<body>
    <div class="container main-container">
        <!-- Header -->
        <div class="header-gradient">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-5 mb-2">Gestión de Clientes</h1>
                    <p class="lead mb-0">Administra tu cartera de clientes de manera eficiente</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="/Clientes/Create" class="btn-primary-gradient">
                        Nuevo Cliente
                    </a>
                </div>
            </div>
        </div>

        <!-- Alertas -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Search Box -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Buscar por nombre, identificación o teléfono">
                </div>
            </div>
            <div class="col-md-6 text-end">
                <span class="badge-cliente">
                    Total: @(Model.Clientes?.Count ?? 0) clientes
                </span>
            </div>
        </div>

        <!-- Tabla de Clientes -->
        <div class="table-responsive">
            <table class="table" id="clientesTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Identificación</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Correo electrónico</th>
                        <th>Dirección</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes != null && Model.Clientes.Any())
                    {
                        @foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td class="fw-bold">@cliente.id_cliente</td>
                                <td>@(string.IsNullOrEmpty(cliente.identificacion) ? "—" : cliente.identificacion)</td>
                                <td>@cliente.nombre</td>
                                <td>@(string.IsNullOrEmpty(cliente.telefono) ? "—" : cliente.telefono)</td>
                                <td>@(string.IsNullOrEmpty(cliente.email) ? "—" : cliente.email)</td>
                                <td>@(string.IsNullOrEmpty(cliente.direccion) ? "—" : (cliente.direccion.Length > 30 ? cliente.direccion.Substring(0, 30) + "..." : cliente.direccion))</td>
                                <td>
                                    <a href="/Clientes/Edit?id=@cliente.id_cliente" class="btn-edit">
                                        Editar
                                    </a>
                                    <a href="/Clientes/Delete?id=@cliente.id_cliente" class="btn-delete">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <h5>No hay clientes registrados</h5>
                                <a href="/Clientes/Create" class="btn btn-primary mt-3">Agregar cliente</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer Stats -->
        <div class="stats-card">
            <div class="row">
                <div class="col-md-6 text-start">
                    Total de clientes: <strong>@(Model.Clientes?.Count ?? 0)</strong>
                </div>
                <div class="col-md-6 text-end">
                    Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Clientes/index.js"></script>
</body>
</html>