@page
@model FactMiscelanea.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .main-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 30px;
        }

        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            color: white;
        }

        .btn-primary-gradient {
            background: white;
            color: #667eea;
            border: none;
            padding: 10px 25px;
            font-weight: 600;
            border-radius: 10px;
            transition: transform 0.3s;
        }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            color: #764ba2;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

        .table thead th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
        }

        .table tbody td {
            padding: 12px 15px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .search-box {
            position: relative;
            max-width: 350px;
            margin-bottom: 20px;
        }

        .search-box input {
            padding-left: 40px;
            border-radius: 25px;
            border: 2px solid #e2e8f0;
            height: 45px;
            width: 100%;
        }

        .search-box input:focus {
            border-color: #667eea;
            outline: none;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 14px;
            color: #a0aec0;
        }

        .btn-edit {
            background-color: #ed8936;
            color: white;
            border: none;
            padding: 5px 12px;
            border-radius: 20px;
            margin-right: 5px;
            text-decoration: none;
            display: inline-block;
            font-size: 12px;
        }

        .btn-edit:hover {
            background-color: #dd6b20;
            color: white;
        }

        .btn-delete {
            background-color: #e53e3e;
            color: white;
            border: none;
            padding: 5px 12px;
            border-radius: 20px;
            text-decoration: none;
            display: inline-block;
            font-size: 12px;
        }

        .btn-delete:hover {
            background-color: #c53030;
            color: white;
        }

        .badge-cliente {
            background: #e2e8f0;
            color: #4a5568;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 13px;
        }

        .stats-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 12px 20px;
            margin-top: 20px;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 20px;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .main-container {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>
<body>
    <div class="container main-container">
        <!-- Header -->
        <div class="header-gradient">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-5 mb-2">
                        <i class="fas fa-users me-3"></i>Gestión de Clientes
                    </h1>
                    <p class="lead mb-0">Administra tu cartera de clientes de manera eficiente</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="/Clientes/Create" class="btn-primary-gradient">
                        <i class="fas fa-plus-circle me-2"></i>Nuevo Cliente
                    </a>
                </div>
            </div>
        </div>

        <!-- Alertas -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Search Box -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Buscar por nombre, identificación o teléfono...">
                </div>
            </div>
            <div class="col-md-6 text-end">
                <span class="badge-cliente">
                    <i class="fas fa-users me-1"></i> Total: @(Model.Clientes?.Count ?? 0) clientes
                </span>
            </div>
        </div>

        <!-- Tabla de Clientes -->
        <div class="table-responsive">
            <table class="table" id="clientesTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Identificación</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Dirección</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes != null && Model.Clientes.Any())
                    {
                        @foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td class="fw-bold">@cliente.id_cliente</td>
                                <td>@(string.IsNullOrEmpty(cliente.identificacion) ? "—" : cliente.identificacion)</td>
                                <td>@cliente.nombre</td>
                                <td>@(string.IsNullOrEmpty(cliente.telefono) ? "—" : cliente.telefono)</td>
                                <td>@(string.IsNullOrEmpty(cliente.email) ? "—" : cliente.email)</td>
                                <td>@(string.IsNullOrEmpty(cliente.direccion) ? "—" : (cliente.direccion.Length > 30 ? cliente.direccion.Substring(0, 30) + "..." : cliente.direccion))</td>
                                <td>
                                    <a href="/Clientes/Edit?id=@cliente.id_cliente" class="btn-edit">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <a href="/Clientes/Delete?id=@cliente.id_cliente" class="btn-delete">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="fas fa-users-slash fa-3x mb-3 d-block text-muted"></i>
                                <h5>No hay clientes registrados</h5>
                                <a href="/Clientes/Create" class="btn btn-primary mt-3">Agregar Cliente</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer Stats -->
        <div class="stats-card">
            <div class="row">
                <div class="col-md-6 text-start">
                    <i class="fas fa-chart-line me-2"></i>
                    Total de clientes: <strong>@(Model.Clientes?.Count ?? 0)</strong>
                </div>
                <div class="col-md-6 text-end">
                    <i class="fas fa-clock me-2"></i>
                    Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Búsqueda en tiempo real
        $("#searchInput").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#clientesTable tbody tr").each(function() {
                var texto = $(this).text().toLowerCase();
                $(this).toggle(texto.indexOf(value) > -1);
            });
        });

        // Auto-cerrar alertas después de 5 segundos
        $(document).ready(function() {
            setTimeout(function() {
                $(".alert").fadeOut("slow", function() {
                    $(this).remove();
                });
            }, 5000);
        });
    </script>
</body>
</html>