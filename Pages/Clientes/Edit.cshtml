@page
@model FactMiscelanea.Pages.Clientes.EditModel
@{
    ViewData["Title"] = "Editar Cliente";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Clientes/edit.css" />
</head>
<body>
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <h2 class="mt-2">Editar Cliente</h2>
                <p class="text-muted">Modifica los datos del cliente</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form method="post">
                <input type="hidden" asp-for="cliente.id_cliente" />

                <div class="mb-3">
                    <label>Identificación</label>
                    <input asp-for="cliente.identificacion" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Nombre</label>
                    <input asp-for="cliente.nombre" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label>Teléfono</label>
                    <input asp-for="cliente.telefono" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Correo electrónico</label>
                    <input asp-for="cliente.email" type="email" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Dirección</label>
                    <textarea asp-for="cliente.direccion" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-submit">
                    Guardar Cambios
                </button>

                <div class="text-center mt-3">
                    <a href="/Clientes" class="text-decoration-none">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>