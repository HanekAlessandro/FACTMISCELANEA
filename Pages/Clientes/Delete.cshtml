@page
@model FactMiscelanea.Pages.Clientes.DeleteModel
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 50px 0;
        }
        .delete-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            margin: auto;
            text-align: center;
        }
        .warning-icon {
            font-size: 80px;
            color: #dc3545;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="delete-container">
            <div class="warning-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3>Confirmar Eliminación</h3>
            <p>¿Estás seguro de eliminar al cliente <strong>@Model.cliente.nombre</strong>?</p>
            <p class="text-muted small">Esta acción no se puede deshacer</p>

            <form method="post">
                <input type="hidden" asp-for="cliente.id_cliente" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Sí, Eliminar
                </button>
                <a href="/Clientes" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
            </form>
        </div>
    </div>
</body>
</html>