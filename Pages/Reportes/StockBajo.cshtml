@page
@model FactMiscelanea.Pages.Reportes.StockBajoModel
@{
    ViewData["Title"] = "Stock Bajo - Reporte";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Reportes/stock-bajo.css" />
</head>
<body>
    <div class="container report-container">
        <div class="header-report">
            <h1>Productos con Stock Bajo</h1>
            <p class="mb-0">Productos que necesitan reabastecimiento inmediato</p>
            <small>Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>

        @if (Model.ProductosStockBajo.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered" id="tablaStock">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Stock Actual</th>
                            <th>Stock Mínimo</th>
                            <th>Diferencia</th>
                            <th>Urgencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model.ProductosStockBajo)
                        {
                            int diferencia = producto.stock_minimo - producto.stock_actual;
                            string urgencia = diferencia <= 2 ? "Muy urgente" : "Moderada";
                            string claseUrgencia = diferencia <= 2 ? "urgent" : "";
                            <tr>
                                <td class="@claseUrgencia">@producto.codigo_barras</td>
                                <td class="@claseUrgencia">@producto.nombre</td>
                                <td class="@claseUrgencia">@(producto.Categoria?.nombre_categoria ?? "Sin categoría")</td>
                                <td class="@claseUrgencia fw-bold text-danger">@producto.stock_actual</td>
                                <td class="@claseUrgencia">@producto.stock_minimo</td>
                                <td class="@claseUrgencia">Faltan @diferencia unidades</td>
                                <td class="@claseUrgencia">@urgencia</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-warning mt-3">
                <strong>Total:</strong> @Model.ProductosStockBajo.Count productos necesitan reabastecimiento
            </div>
        }
        else
        {
            <div class="alert alert-success">
                Muy bien. Todos los productos tienen stock suficiente.
            </div>
        }

        <div class="text-end mt-4">
            <button onclick="window.print()" class="btn btn-primary">
                Imprimir Reporte
            </button>
            <button onclick="exportToExcel()" class="btn btn-success">
                Exportar a Excel
            </button>
            <a href="/Reportes" class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/Reportes/stock-bajo.js"></script>
</body>
</html>