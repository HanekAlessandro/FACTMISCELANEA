@page
@model FactMiscelanea.Pages.Reportes.ResumenGeneralModel
@{
    ViewData["Title"] = "Resumen General - Reporte";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 30px;
        }
        .report-container {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .header-report {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            color: white;
        }
        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s;
            margin-bottom: 20px;
        }
        .stat-card:hover {
            transform: translateY(-5px);
        }
        .stat-icon {
            font-size: 40px;
            margin-bottom: 10px;
        }
        .stat-number {
            font-size: 32px;
            font-weight: bold;
        }
        .stat-label {
            color: #666;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container report-container">
        <div class="header-report">
            <div class="row">
                <div class="col-md-8">
                    <h1><i class="fas fa-chart-pie me-3"></i>Resumen General del Negocio</h1>
                    <p class="mb-0">Estadísticas globales y rendimiento del sistema</p>
                </div>
                <div class="col-md-4 text-end">
                    <p class="mb-0"><i class="fas fa-calendar-alt me-2"></i>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-primary">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <div class="stat-number">@Model.TotalProductos</div>
                    <div class="stat-label">Productos Registrados</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-success">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-number">@Model.TotalClientes</div>
                    <div class="stat-label">Clientes</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-info">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div class="stat-number">@Model.TotalFacturas</div>
                    <div class="stat-label">Facturas Emitidas</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-warning">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div class="stat-number">@Model.TotalCategorias</div>
                    <div class="stat-label">Categorías</div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="stat-card">
                    <div class="stat-icon text-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stat-number">@Model.ProductosStockBajo</div>
                    <div class="stat-label">Productos con Stock Bajo</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-card">
                    <div class="stat-icon text-secondary">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="stat-number">₡@Model.IngresoTotal.ToString("N2")</div>
                    <div class="stat-label">Ingreso Total Facturado</div>
                </div>
            </div>
        </div>

        <div class="text-end mt-4">
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fas fa-print me-2"></i>Imprimir Reporte
            </button>
            <a href="/Reportes" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>
</body>
</html>