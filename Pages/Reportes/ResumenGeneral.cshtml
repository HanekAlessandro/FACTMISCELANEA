@page
@model FactMiscelanea.Pages.Reportes.ResumenGeneralModel
@{
    ViewData["Title"] = "Resumen General - Reporte";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Reportes/resumen-general.css" />
</head>
<body>
    <div class="container report-container">
        <div class="header-report">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1>Resumen General del Negocio</h1>
                    <p class="mb-0">Estadísticas globales y rendimiento del sistema</p>
                </div>
                <div class="col-md-4 text-end">
                    <p class="mb-0">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-0">Generado por: Sistema</p>
                </div>
            </div>
        </div>

        <div class="info-empresa">
            <div class="row">
                <div class="col-md-12 text-center">
                    <h3>Miscelánea Master</h3>
                    <p class="mb-0">Nit: 123456789 | Tel: 1234-5678</p>
                    <p class="mb-0">Dirección: Calle Principal 123</p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-primary">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <div class="stat-number">@Model.TotalProductos</div>
                    <div class="stat-label">Productos Registrados</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-success">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-number">@Model.TotalClientes</div>
                    <div class="stat-label">Clientes</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-info">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div class="stat-number">@Model.TotalFacturas</div>
                    <div class="stat-label">Facturas Emitidas</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-warning">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div class="stat-number">@Model.TotalCategorias</div>
                    <div class="stat-label">Categorías</div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="stat-card">
                    <div class="stat-icon text-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stat-number">@Model.ProductosStockBajo</div>
                    <div class="stat-label">Productos con Stock Bajo</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-card">
                    <div class="stat-icon text-secondary">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="stat-number">₡@Model.IngresoTotal.ToString("N2")</div>
                    <div class="stat-label">Ingreso Total Facturado</div>
                </div>
            </div>
        </div>

        <div class="footer-reporte">
            <div class="row">
                <div class="col-md-6 text-start">
                    <p class="mb-0">Reporte generado por el sistema de facturación</p>
                    <p class="mb-0">Miscelánea Master - Todos los derechos reservados</p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="mb-0">Página 1 de 1</p>
                    <p class="mb-0">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 no-print">
            <button onclick="window.print()" class="btn btn-primary">
                Imprimir Reporte
            </button>
            <a href="/Reportes" class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
</body>
</html>