@page
@model FactMiscelanea.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 30px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .dashboard-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            color: white;
        }
        .card-reporte {
            transition: transform 0.3s, box-shadow 0.3s;
            border-radius: 15px;
            overflow: hidden;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .card-reporte:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }
        .card-reporte .card-header {
            font-size: 1.2rem;
            font-weight: bold;
            padding: 15px;
        }
        .card-reporte .card-body {
            padding: 25px;
        }
        .icon-circle {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 30px;
        }
    </style>
</head>
<body>
    <div class="container dashboard-container">
        <div class="header-gradient">
            <h1 class="display-4">
                <i class="fas fa-chart-pie me-3"></i>Centro de Reportes
            </h1>
            <p class="lead mb-0">Visualiza estadísticas y análisis de tu negocio en tiempo real</p>
            <hr class="bg-light my-3">
            <small><i class="fas fa-calendar-alt me-2"></i>Reportes generados en: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>

        <div class="row">
            <!-- Reporte 1: Stock Bajo -->
            <div class="col-md-6 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-warning text-dark">
                        <i class="fas fa-exclamation-triangle me-2"></i>Productos con Stock Bajo
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-warning bg-opacity-25">
                            <i class="fas fa-boxes text-warning"></i>
                        </div>
                        <p>Lista de productos que necesitan reabastecimiento inmediato.</p>
                        <p class="text-muted small">
                            <i class="fas fa-chart-line me-1"></i> Muestra productos con stock actual ≤ stock mínimo
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/StockBajo" class="btn btn-warning w-100">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>

            <!-- Reporte 2: Resumen General -->
            <div class="col-md-6 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-chart-simple me-2"></i>Resumen General del Negocio
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-primary bg-opacity-25">
                            <i class="fas fa-building text-primary"></i>
                        </div>
                        <p>Estadísticas globales del sistema.</p>
                        <p class="text-muted small">
                            <i class="fas fa-database me-1"></i> Productos, clientes, facturas y más
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/ResumenGeneral" class="btn btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver al Inicio
            </a>
        </div>
    </div>
</body>
</html>