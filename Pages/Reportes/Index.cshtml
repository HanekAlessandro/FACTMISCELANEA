@page
@model FactMiscelanea.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 30px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .dashboard-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            color: white;
        }
        .card-reporte {
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            border-radius: 15px;
            overflow: hidden;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .card-reporte:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }
        .card-reporte .card-header {
            font-size: 1.2rem;
            font-weight: bold;
            padding: 15px;
        }
        .card-reporte .card-body {
            padding: 25px;
        }
        .icon-circle {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 30px;
        }
    </style>
</head>
<body>
    <div class="container dashboard-container">
        <div class="header-gradient">
            <h1 class="display-4">
                <i class="fas fa-chart-pie me-3"></i>Centro de Reportes
            </h1>
            <p class="lead mb-0">Visualiza estadísticas y análisis de tu negocio en tiempo real</p>
            <hr class="bg-light my-3">
            <small><i class="fas fa-calendar-alt me-2"></i>Reportes generados en: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>

        <div class="row">
            <!-- Reporte 1: Stock Bajo -->
            <div class="col-md-4 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-warning text-dark">
                        <i class="fas fa-exclamation-triangle me-2"></i>Productos con Stock Bajo
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-warning bg-opacity-25">
                            <i class="fas fa-boxes text-warning"></i>
                        </div>
                        <p>Lista de productos que necesitan reabastecimiento inmediato.</p>
                        <p class="text-muted small">
                            <i class="fas fa-chart-line me-1"></i> Muestra productos con stock actual ≤ stock mínimo
                        </p>
                        <div class="mt-3" id="stockBajoCount">Cargando...</div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/StockBajo" class="btn btn-warning w-100">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>

            <!-- Reporte 2: Ventas Mensuales -->
            <div class="col-md-4 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-info text-white">
                        <i class="fas fa-chart-line me-2"></i>Ventas Mensuales
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-info bg-opacity-25">
                            <i class="fas fa-chart-line text-info"></i>
                        </div>
                        <p>Análisis de ventas por mes con gráficos interactivos.</p>
                        <p class="text-muted small">
                            <i class="fas fa-calendar me-1"></i> Tendencia de ingresos mensuales
                        </p>
                        <div class="mt-3" id="ventasCount">Cargando...</div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/VentasMensuales" class="btn btn-info w-100 text-white">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>

            <!-- Reporte 3: Top Productos -->
            <div class="col-md-4 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-trophy me-2"></i>Top 10 Productos
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-success bg-opacity-25">
                            <i class="fas fa-trophy text-success"></i>
                        </div>
                        <p>Los productos más vendidos en tu negocio.</p>
                        <p class="text-muted small">
                            <i class="fas fa-chart-simple me-1"></i> Ranking de popularidad
                        </p>
                        <div class="mt-3" id="topProductosCount">Cargando...</div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/TopProductos" class="btn btn-success w-100">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <!-- Reporte 4: Resumen General -->
            <div class="col-md-6 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-chart-simple me-2"></i>Resumen General del Negocio
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-primary bg-opacity-25">
                            <i class="fas fa-building text-primary"></i>
                        </div>
                        <p>Estadísticas globales del sistema.</p>
                        <p class="text-muted small">
                            <i class="fas fa-database me-1"></i> Productos, clientes, facturas y más
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/ResumenGeneral" class="btn btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>

            <!-- Reporte 5: Reporte Financiero -->
            <div class="col-md-6 mb-4">
                <div class="card card-reporte h-100">
                    <div class="card-header bg-danger text-white">
                        <i class="fas fa-dollar-sign me-2"></i>Reporte Financiero
                    </div>
                    <div class="card-body text-center">
                        <div class="icon-circle bg-danger bg-opacity-25">
                            <i class="fas fa-coins text-danger"></i>
                        </div>
                        <p>Ingresos totales, impuestos y análisis financiero.</p>
                        <p class="text-muted small">
                            <i class="fas fa-chart-pie me-1"></i> Rentabilidad del negocio
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/Financiero" class="btn btn-danger w-100">
                            <i class="fas fa-eye me-2"></i>Ver Reporte Completo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver al Inicio
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fas fa-print me-2"></i>Imprimir Dashboard
            </button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Cargar contadores dinámicamente
        $(document).ready(function() {
            $.get("/Reportes/GetStockBajoCount", function(data) {
                $("#stockBajoCount").html(`<span class="badge bg-warning fs-6">${data} productos</span>`);
            });
            
            $.get("/Reportes/GetVentasCount", function(data) {
                $("#ventasCount").html(`<span class="badge bg-info fs-6">${data} meses con ventas</span>`);
            });
            
            $.get("/Reportes/GetTopProductosCount", function(data) {
                $("#topProductosCount").html(`<span class="badge bg-success fs-6">Top ${data} productos</span>`);
            });
        });
    </script>
</body>
</html>