@page
@model FactMiscelanea.Pages.Productos.EditModel
@{
    ViewData["Title"] = "Editar Producto";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 50px 0;
        }
        
        .form-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
            max-width: 600px;
            margin: auto;
        }
        
        .form-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .form-header i {
            font-size: 60px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        .btn-submit {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            font-size: 18px;
            font-weight: bold;
            transition: transform 0.3s;
        }
        
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .btn-cancel {
            background: #6c757d;
            border: none;
            padding: 12px;
            font-size: 18px;
            font-weight: bold;
        }
        
        .btn-cancel:hover {
            background: #5a6268;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <i class="fas fa-edit"></i>
                <h2>Editar Producto</h2>
                <p class="text-muted">Modifica los datos del producto</p>
            </div>
            
            <form method="post">
                <input type="hidden" asp-for="Producto.id_producto" />
                
                <div class="form-group">
                    <label><i class="fas fa-barcode me-2"></i>Código de Barras</label>
                    <input asp-for="Producto.codigo_barras" class="form-control form-control-lg" required>
                    <span asp-validation-for="Producto.codigo_barras" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label><i class="fas fa-tag me-2"></i>Nombre</label>
                    <input asp-for="Producto.nombre" class="form-control form-control-lg" required>
                    <span asp-validation-for="Producto.nombre" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label><i class="fas fa-align-left me-2"></i>Descripción</label>
                    <textarea asp-for="Producto.descripcion" class="form-control" rows="3"></textarea>
                </div>
                
                <div class="form-group">
                    <label><i class="fas fa-folder me-2"></i>Categoría</label>
                    <select asp-for="Producto.id_categoria" class="form-control form-control-lg" 
                            asp-items="@Model.CategoriasList">
                        <option value="">-- Seleccione una categoría --</option>
                    </select>
                    <span asp-validation-for="Producto.id_categoria" class="text-danger"></span>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label><i class="fas fa-cubes me-2"></i>Existencias</label>
                            <input asp-for="Producto.stock_actual" class="form-control form-control-lg" min="0">
                            <span asp-validation-for="Producto.stock_actual" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label><i class="fas fa-exclamation-triangle me-2"></i>Stock Mínimo</label>
                            <input asp-for="Producto.stock_minimo" class="form-control form-control-lg" min="0">
                            <span asp-validation-for="Producto.stock_minimo" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label><i class="fas fa-percent me-2"></i>IVA (%)</label>
                    <input asp-for="Producto.iva_porcentaje" class="form-control form-control-lg" step="0.01" min="0">
                    <span asp-validation-for="Producto.iva_porcentaje" class="text-danger"></span>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-submit">
                        <i class="fas fa-save me-2"></i>Actualizar Producto
                    </button>
                    <a href="/Productos" class="btn btn-secondary btn-cancel">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>