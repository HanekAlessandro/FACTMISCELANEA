@page
@model FactMiscelanea.Pages.Productos.EditModel
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3>Editar Producto</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Producto.id_producto" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Código de Barras</label>
                                    <input asp-for="Producto.codigo_barras" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Nombre</label>
                                    <input asp-for="Producto.nombre" class="form-control" required />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label>Descripción</label>
                            <textarea asp-for="Producto.descripcion" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Categoría</label>
                                    <select asp-for="Producto.id_categoria" class="form-control" asp-items="@Model.CategoriasList">
                                        <option value="">Selecciona una categoría</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Precio de Venta en colones</label>
                                    <input asp-for="Precio" class="form-control" type="number" step="0.01" required />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label>Stock Actual</label>
                                    <input asp-for="Producto.stock_actual" class="form-control" min="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label>Stock Mínimo</label>
                                    <input asp-for="Producto.stock_minimo" class="form-control" min="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label>IVA en porcentaje</label>
                                    <input asp-for="Producto.iva_porcentaje" class="form-control" step="0.01" />
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning w-100">
                            Actualizar Producto
                        </button>
                    </form>
                </div>
                <div class="card-footer">
                    <a href="/Productos" class="btn btn-secondary">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>