@page
@model FactMiscelanea.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Productos - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Usar doble @@ para keyframes en Razor */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideIn {
            from {
                transform: translateX(-100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .main-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 30px;
            animation: fadeIn 0.5s ease-out;
        }

        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            color: white;
            animation: slideIn 0.5s ease-out;
        }

        .btn-primary-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            transition: transform 0.3s, box-shadow 0.3s;
            padding: 10px 25px;
            font-weight: 600;
        }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .table-modern {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .table-modern thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .table-modern thead th {
            padding: 15px;
            font-weight: 600;
        }

        .table-modern tbody tr {
            transition: background-color 0.3s;
        }

        .table-modern tbody tr:hover {
            background-color: #f8f9fa;
        }

        .badge-stock {
            font-size: 14px;
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: 600;
        }

        .badge-stock-low {
            background-color: #f56565;
            color: white;
        }

        .badge-stock-normal {
            background-color: #48bb78;
            color: white;
        }

        .action-buttons .btn {
            margin: 0 3px;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 13px;
        }

        .search-box {
            position: relative;
            max-width: 400px;
        }

        .search-box input {
            padding-left: 40px;
            border-radius: 25px;
            border: 2px solid #e2e8f0;
            transition: border-color 0.3s;
        }

        .search-box input:focus {
            border-color: #667eea;
            box-shadow: none;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 12px;
            color: #a0aec0;
            z-index: 10;
        }

        .filter-buttons .btn {
            border-radius: 20px;
            padding: 8px 20px;
            margin: 0 5px;
        }

        .alert-custom {
            border-radius: 10px;
            animation: fadeIn 0.3s ease-out;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-state i {
            font-size: 80px;
            color: #cbd5e0;
            margin-bottom: 20px;
        }

        .stats-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 10px 20px;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container main-container">
        <!-- Header -->
        <div class="header-gradient">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-5 mb-2">
                        <i class="fas fa-boxes me-3"></i>Gestión de Productos
                    </h1>
                    <p class="lead mb-0">Administra tu inventario de manera eficiente</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="/Productos/Create" class="btn btn-light btn-lg btn-primary-gradient">
                        <i class="fas fa-plus-circle me-2"></i>Nuevo Producto
                    </a>
                </div>
            </div>
        </div>

        <!-- Alertas -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show alert-custom" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show alert-custom" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Search and Filter -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" class="form-control" 
                           placeholder="Buscar por código, nombre o categoría...">
                </div>
            </div>
            <div class="col-md-6 text-end filter-buttons">
                <button class="btn btn-outline-secondary" onclick="filterByStock('all')">
                    <i class="fas fa-list me-1"></i>Todos
                </button>
                <button class="btn btn-outline-warning" onclick="filterByStock('low')">
                    <i class="fas fa-exclamation-triangle me-1"></i>Stock Bajo
                </button>
            </div>
        </div>

        <!-- Products Table -->
        <div class="table-responsive">
            <table class="table table-modern table-hover" id="productsTable">
                <thead>
                    <tr>
                        <th><i class="fas fa-barcode me-2"></i>Código</th>
                        <th><i class="fas fa-tag me-2"></i>Nombre</th>
                        <th><i class="fas fa-folder me-2"></i>Categoría</th>
                        <th><i class="fas fa-box me-2"></i>Stock</th>
                        <th><i class="fas fa-percent me-2"></i>IVA</th>
                        <th><i class="fas fa-cogs me-2"></i>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Productos != null && Model.Productos.Any())
                    {
                        @foreach (var producto in Model.Productos)
                        {
                            <tr>
                                <td>
                                    <strong>@producto.codigo_barras</strong>
                                </td>
                                <td>@producto.nombre</td>
                                <td>
                                    @if (producto.Categoria != null)
                                    {
                                        <span class="badge bg-info text-dark">
                                            <i class="fas fa-folder-open me-1"></i>@producto.Categoria.nombre_categoria
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-question me-1"></i>Sin categoría
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var stockClass = producto.stock_actual <= producto.stock_minimo ? "badge-stock-low" : "badge-stock-normal";
                                    }
                                    <span class="badge-stock @stockClass">
                                        <i class="fas fa-cubes me-1"></i>@producto.stock_actual unidades
                                    </span>
                                    @if (producto.stock_actual <= producto.stock_minimo)
                                    {
                                        <small class="text-danger d-block mt-1">
                                            <i class="fas fa-exclamation-circle"></i> Mínimo: @producto.stock_minimo
                                        </small>
                                    }
                                </td>
                                <td>@producto.iva_porcentaje.ToString("0.00")%</td>
                                <td class="action-buttons">
                                    <a href="/Productos/Edit?id=@producto.id_producto" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <a href="/Productos/Delete?id=@producto.id_producto" class="btn btn-sm btn-danger" 
                                       onclick="return confirm('¿Estás seguro de eliminar @producto.nombre?')">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-box-open"></i>
                                    <h4>No hay productos registrados</h4>
                                    <p class="text-muted">Comienza agregando tu primer producto</p>
                                    <a href="/Productos/Create" class="btn btn-primary">
                                        <i class="fas fa-plus-circle me-2"></i>Agregar Producto
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer Stats -->
        <div class="stats-card">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">
                        <i class="fas fa-chart-line me-2"></i>
                        Total de productos: <strong>@(Model.Productos?.Count ?? 0)</strong>
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="mb-0">
                        <i class="fas fa-clock me-2"></i>
                        Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-cerrar alertas después de 5 segundos
        $(document).ready(function() {
            setTimeout(function() {
                $(".alert").fadeOut("slow", function() {
                    $(this).remove();
                });
            }, 5000);
        });
        
        // Búsqueda en tiempo real
        $("#searchInput").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#productsTable tbody tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });
        
        // Filtro por stock
        function filterByStock(type) {
            $("#productsTable tbody tr").each(function() {
                var stockText = $(this).find("td:eq(3)").text();
                var stock = parseInt(stockText);
                
                if (type === 'all') {
                    $(this).show();
                } else if (type === 'low') {
                    var isLow = stockText.includes("Mínimo:") || stock <= 5;
                    $(this).toggle(isLow);
                }
            });
            
            // Actualizar estilo de botones activos
            $('.filter-buttons .btn').removeClass('active');
            if (type === 'all') {
                $('.filter-buttons .btn:first').addClass('active btn-primary');
            } else {
                $('.filter-buttons .btn:last').addClass('active btn-warning');
            }
        }
        
        // Confirmación para eliminar
        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function(e) {
                if (!confirm('¿Estás seguro de eliminar este producto?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
</body>
</html>