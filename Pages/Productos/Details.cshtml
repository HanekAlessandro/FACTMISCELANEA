@page
@model FactMiscelanea.Pages.Productos.DeleteModel
@{
    ViewData["Title"] = "Eliminar Producto";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 50px 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .delete-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
            max-width: 600px;
            margin: auto;
        }

        .product-details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
        }

        .btn-danger {
            background: #dc3545;
            padding: 10px 25px;
            font-weight: 600;
            border: none;
            transition: transform 0.3s;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            background: #c82333;
        }

        .btn-secondary {
            padding: 10px 25px;
            font-weight: 600;
            transition: transform 0.3s;
        }

        .btn-secondary:hover {
            transform: translateY(-2px);
        }

        .icon-warning {
            font-size: 80px;
            color: #dc3545;
        }

        .alert {
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="delete-container">
            <div class="text-center mb-4">
                <i class="fas fa-exclamation-triangle icon-warning"></i>
                <h2 class="mt-3">Confirmar Eliminación</h2>
                <p class="text-muted">¿Estás seguro de que deseas eliminar este producto?</p>
                <p class="text-danger small">⚠️ Esta acción no se puede deshacer</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.Producto != null && Model.Producto.id_producto > 0)
            {
                <div class="product-details">
                    <h5><i class="fas fa-info-circle me-2"></i>Información del Producto</h5>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">Código:</dt>
                        <dd class="col-sm-8">@Model.Producto.codigo_barras</dd>

                        <dt class="col-sm-4">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Producto.nombre</dd>

                        <dt class="col-sm-4">Categoría:</dt>
                        <dd class="col-sm-8">@(Model.Producto.Categoria?.nombre_categoria ?? "Sin categoría")</dd>

                        <dt class="col-sm-4">Stock Actual:</dt>
                        <dd class="col-sm-8">@Model.Producto.stock_actual unidades</dd>

                        <dt class="col-sm-4">Stock Mínimo:</dt>
                        <dd class="col-sm-8">@Model.Producto.stock_minimo unidades</dd>

                        <dt class="col-sm-4">IVA:</dt>
                        <dd class="col-sm-8">@Model.Producto.iva_porcentaje.ToString("0.00")%</dd>
                    </dl>
                </div>

                <div class="text-center mt-4">
                    <form method="post">
                        <input type="hidden" name="id" value="@Model.Producto.id_producto" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Sí, Eliminar Producto
                        </button>
                        <a href="/Productos" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </form>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-search me-2"></i> Producto no encontrado
                </div>
                <div class="text-center">
                    <a href="/Productos" class="btn btn-primary">Volver a Productos</a>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>