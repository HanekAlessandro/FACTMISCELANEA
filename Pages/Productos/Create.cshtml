@page
@model FactMiscelanea.Pages.Productos.CreateModel
@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3>Nuevo Producto</h3>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Código de Barras</label>
                                    <input asp-for="Producto.codigo_barras" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Nombre</label>
                                    <input asp-for="Producto.nombre" class="form-control" required />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label>Descripción</label>
                            <textarea asp-for="Producto.descripcion" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Categoría</label>
                                    <select asp-for="Producto.id_categoria" class="form-control" asp-items="@Model.CategoriasList">
                                        <option value="">Selecciona una categoría</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Precio de Venta en colones</label>
                                    <input asp-for="Precio" class="form-control" type="number" step="0.01" required />
                                    <span asp-validation-for="Precio" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label>Stock Actual</label>
                                    <input asp-for="Producto.stock_actual" class="form-control" value="0" min="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label>Stock Mínimo</label>
                                    <input asp-for="Producto.stock_minimo" class="form-control" value="5" min="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label>IVA en porcentaje</label>
                                    <input asp-for="Producto.iva_porcentaje" class="form-control" value="15" step="0.01" />
                                </div>
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-success">
                                Guardar Producto
                            </button>
                            <a href="/Productos" class="btn btn-secondary ms-2">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>