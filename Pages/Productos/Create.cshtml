@page
@model FactMiscelanea.Pages.Productos.CreateModel

<h1>Crear Producto</h1>

<form method="post">

    <div class="mb-3">
        <label class="form-label">Código</label>
        <input asp-for="Producto.codigo_barras" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Producto.nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <input asp-for="Producto.descripcion" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Categoría</label>

        <select asp-for="Producto.id_categoria"
                asp-items="Model.Categorias"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input asp-for="Producto.stock_actual" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Stock Mínimo</label>
        <input asp-for="Producto.stock_minimo" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">IVA</label>
        <input asp-for="Producto.iva_porcentaje" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Volver
    </a>

</form>