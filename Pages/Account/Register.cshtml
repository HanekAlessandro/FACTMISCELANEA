@page
@model FactMiscelanea.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Account/register.css" />
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <h2>Crea tu cuenta</h2>
            <p class="text-muted">Completa los datos para registrarte</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post">
            <div class="form-group">
                <label>Nombre Completo</label>
                <input asp-for="Input.NombreCompleto" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Correo electrónico</label>
                <input asp-for="Input.Email" type="email" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Nombre de Usuario</label>
                <input asp-for="Input.NombreUsuario" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input asp-for="Input.Password" type="password" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Confirmar Contraseña</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary btn-register">
                Registrarme
            </button>
        </form>

        <div class="login-link">
            <p>Ya tengo una cuenta. <a href="/Account/Login">Ingresar ahora</a></p>
        </div>
    </div>
</body>
</html>