@page
@model FactMiscelanea.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .dashboard-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        
        .welcome-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            color: white;
        }
        
        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s;
            cursor: pointer;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
        }
        
        .stat-icon {
            font-size: 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .stat-number {
            font-size: 32px;
            font-weight: bold;
            margin: 10px 0;
        }
        
        .stock-warning {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 10px;
            margin: 5px 0;
            border-radius: 5px;
        }
        
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .dashboard-container {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>
<body>
    <div class="container dashboard-container">
        <div class="welcome-header">
            <h1 class="display-4">
                <i class="fas fa-store me-3"></i>Miscelánea Master
            </h1>
            <p class="lead">Sistema de facturación y control de inventario</p>
            <hr class="bg-light">
            <p class="mb-0">
                <i class="fas fa-calendar-alt me-2"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-boxes stat-icon"></i>
                    <div class="stat-number">@Model.TotalProducts</div>
                    <div class="text-muted">Productos</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-users stat-icon"></i>
                    <div class="stat-number">@Model.TotalClientes</div>
                    <div class="text-muted">Clientes</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-file-invoice-dollar stat-icon"></i>
                    <div class="stat-number">@Model.TotalFacturas</div>
                    <div class="text-muted">Facturas</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-tags stat-icon"></i>
                    <div class="stat-number">@Model.TotalCategorias</div>
                    <div class="text-muted">Categorías</div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Productos con Stock Bajo
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.ProductsStockBajo != null && Model.ProductsStockBajo.Any())
                        {
                            foreach (var producto in Model.ProductsStockBajo)
                            {
                                <div class="stock-warning">
                                    <strong>@producto.nombre</strong><br>
                                    <small class="text-muted">
                                        Código: @producto.codigo_barras<br>
                                        Stock actual: @producto.stock_actual |
                                        Stock mínimo: @producto.stock_minimo
                                    </small>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-success">
                                <i class="fas fa-check-circle me-2"></i>
                                Todos los productos tienen stock adecuado
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-clock me-2"></i>
                            Últimas Facturas
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.UltimasFacturas != null && Model.UltimasFacturas.Any())
                        {
                            <div class="list-group">
                                @foreach (var factura in Model.UltimasFacturas)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>Folio: @factura.folio</strong><br>
                                                <small class="text-muted">
                                                    @factura.fecha_hora.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            </div>
                                            <span class="badge bg-success">
                                                ₡@factura.total_final.ToString("N2")
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No hay facturas registradas</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-bolt me-2"></i>Accesos Rápidos
                        </h5>
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <a href="/Productos" class="btn btn-primary w-100">
                                    <i class="fas fa-box me-2"></i>Gestionar Productos
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/Clientes" class="btn btn-success w-100">
                                    <i class="fas fa-user me-2"></i>Gestionar Clientes
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/Facturas" class="btn btn-info w-100">
                                    <i class="fas fa-receipt me-2"></i>Nueva Factura
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/Reportes" class="btn btn-warning w-100">
                                    <i class="fas fa-chart-bar me-2"></i>Ver Reportes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>