@page
@model FactMiscelanea.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard - Miscelánea Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/index.css" />
</head>
<body>
    <div class="container dashboard-container">
        <!-- Header con información del usuario -->
        <div class="welcome-header">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h1 class="display-4">Miscelánea Master</h1>
                    <p class="lead mb-0">Sistema de facturación y control de inventario</p>
                </div>
                <div class="col-md-5 text-end">
                    <div class="user-info">
                        <strong>@HttpContext.Session.GetString("UsuarioNombre")</strong><br>
                        <span class="badge-role">@HttpContext.Session.GetString("UsuarioRol")</span>
                    </div>
                </div>
            </div>
            <hr class="bg-light my-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="mb-0 greeting">Bienvenido de vuelta</p>
                </div>
            </div>
        </div>

        <!-- Tarjetas de estadísticas -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stat-card text-center" onclick="window.location.href='/Productos'">
                    <i class="fas fa-boxes stat-icon"></i>
                    <div class="stat-number">@Model.TotalProducts.ToString("N0")</div>
                    <div class="stat-label">Productos Registrados</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center" onclick="window.location.href='/Clientes'">
                    <i class="fas fa-users stat-icon"></i>
                    <div class="stat-number">@Model.TotalClientes.ToString("N0")</div>
                    <div class="stat-label">Clientes Activos</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center" onclick="window.location.href='/Facturas'">
                    <i class="fas fa-file-invoice-dollar stat-icon"></i>
                    <div class="stat-number">@Model.TotalFacturas.ToString("N0")</div>
                    <div class="stat-label">Facturas Emitidas</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center" onclick="window.location.href='/Reportes'">
                    <i class="fas fa-tags stat-icon"></i>
                    <div class="stat-number">@Model.TotalCategorias.ToString("N0")</div>
                    <div class="stat-label">Categorías</div>
                </div>
            </div>
        </div>

        <!-- Sección de alertas y actividad reciente -->
        <div class="row">
            <!-- Productos con Stock Bajo -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            Productos con Stock Bajo
                            <span class="badge bg-dark ms-2">@(Model.ProductsStockBajo?.Count ?? 0)</span>
                        </h5>
                    </div>
                    <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.ProductsStockBajo != null && Model.ProductsStockBajo.Any())
                        {
                            foreach (var producto in Model.ProductsStockBajo)
                            {
                                var diferencia = producto.stock_minimo - producto.stock_actual;
                                var isUrgent = diferencia <= 2;
                                <div class="stock-warning @(isUrgent ? "stock-warning-danger" : "")">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@producto.nombre</strong><br>
                                            <small class="text-muted">@producto.codigo_barras</small>
                                        </div>
                                        @if (isUrgent)
                                        {
                                            <span class="badge bg-danger">Muy urgente</span>
                                        }
                                    </div>
                                    <div class="mt-2">
                                        <div class="progress" style="height: 8px;">
                                            @{
                                                var porcentaje = (producto.stock_actual * 100) / producto.stock_minimo;
                                                porcentaje = porcentaje > 100 ? 100 : porcentaje;
                                            }
                                            <div class="progress-bar bg-danger" style="width: @porcentaje%"></div>
                                        </div>
                                        <small class="text-muted">
                                            Stock actual: <strong class="text-danger">@producto.stock_actual</strong> |
                                            Stock mínimo: @producto.stock_minimo |
                                            Faltan: @diferencia unidades
                                        </small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-success mb-0">
                                    Muy bien. Todos los productos tienen stock adecuado.
                                </p>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Reportes/StockBajo" class="btn btn-sm btn-warning w-100">
                            Ver todos los productos con stock bajo
                        </a>
                    </div>
                </div>
            </div>

            <!-- Últimas Facturas -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            Últimas Facturas
                            <span class="badge bg-light text-dark ms-2">@(Model.UltimasFacturas?.Count ?? 0)</span>
                        </h5>
                    </div>
                    <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.UltimasFacturas != null && Model.UltimasFacturas.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var factura in Model.UltimasFacturas)
                                {
                                    <div class="list-group-item border-start-0 border-end-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-primary">@factura.folio</strong><br>
                                                <small class="text-muted">@factura.fecha_hora.ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-success fs-6">
                                                    ₡@factura.total_final.ToString("N2")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-muted mb-0">No hay facturas registradas</p>
                                <a href="/Facturas" class="btn btn-sm btn-primary mt-3">
                                    Crear primera factura
                                </a>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="/Facturas" class="btn btn-sm btn-info w-100 text-white">
                            Ver todas las facturas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accesos Rápidos -->
        <div class="row mt-2">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Accesos Rápidos</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3 col-sm-6">
                                <a href="/Productos" class="btn btn-primary btn-quick w-100">
                                    Productos
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a href="/Clientes" class="btn btn-success btn-quick w-100">
                                    Clientes
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a href="/Facturas" class="btn btn-info btn-quick w-100">
                                    Nueva Factura
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a href="/Reportes" class="btn btn-warning btn-quick w-100">
                                    Reportes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer con estadísticas adicionales -->
        <div class="footer-stats">
            <div class="row">
                <div class="col-md-6 text-start">
                    <small>
                        Total facturado: ₡@Model.TotalIngresos.ToString("N2")
                    </small>
                </div>
                <div class="col-md-6 text-end">
                    <small>
                        Stock bajo: @(Model.ProductsStockBajo?.Count ?? 0) productos
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>