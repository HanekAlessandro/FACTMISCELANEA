@page
@model FactMiscelanea.Pages.Facturas.CreateModel
@{
    ViewData["Title"] = "Nueva Factura";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Facturas/create.css" />
</head>
<body>
    <div class="container factura-container">
        <div class="header-factura">
            <h2>Nueva Factura</h2>
            <p class="mb-0">Complete los datos de la factura</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }

        <form method="post">
            <div class="row mb-4">
                <div class="col-md-3">
                    <label class="fw-bold">Folio:</label>
                    <div class="form-control-plaintext">@Model.Factura.folio</div>
                    <input type="hidden" asp-for="Factura.folio" />
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Fecha:</label>
                    <div class="form-control-plaintext">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Cliente:</label>
                    <select asp-for="Factura.id_cliente" class="form-select">
                        <option value="">Seleccione un cliente</option>
                        @foreach (var cliente in Model.ClientesList) { <option value="@cliente.Value">@cliente.Text</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Método de Pago:</label>
                    <select asp-for="Factura.id_metodo_pago" class="form-select">
                        <option value="">Seleccione un método</option>
                        @foreach (var metodo in Model.MetodosPagoList) { <option value="@metodo.Value">@metodo.Text</option> }
                    </select>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">Agregar Producto</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-5">
                            <label>Producto</label>
                            <select id="productoSelect" class="form-select">
                                <option value="">Seleccione un producto</option>
                                @foreach (var producto in Model.ProductosList) { <option value="@producto.Value">@producto.Text</option> }
                            </select>
                            <div id="stockInfo" class="stock-info"></div>
                        </div>
                        <div class="col-md-2">
                            <label>Cantidad</label>
                            <input type="number" id="cantidadInput" class="form-control" value="1" min="1">
                            <div id="stockError" class="stock-error"></div>
                        </div>
                        <div class="col-md-3">
                            <label>Precio Unitario</label>
                            <input type="text" id="precioInput" class="form-control" readonly>
                        </div>
                        <div class="col-md-2 text-end pt-4">
                            <button type="button" class="btn-agregar" onclick="agregarProducto()">Agregar</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-productos">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>IVA</th>
                            <th>Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="productosBody"></tbody>
                </table>
            </div>

            <div class="total-card">
                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th>Subtotal:</th>
                                <td class="text-end">₡<span id="subtotalTotal">0.00</span><input type="hidden" asp-for="Factura.subtotal_sin_iva" id="subtotalSinIva" value="0" /></td>
                            </tr>
                            <tr>
                                <th>IVA:</th>
                                <td class="text-end">₡<span id="ivaTotal">0.00</span><input type="hidden" asp-for="Factura.total_iva" id="totalIva" value="0" /></td>
                            </tr>
                            <tr class="table-active">
                                <th>Total:</th>
                                <td class="text-end fw-bold">₡<span id="totalFinal">0.00</span><input type="hidden" asp-for="Factura.total_final" id="totalFactura" value="0" /></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn-guardar">Guardar Factura</button>
                <a href="/Facturas" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>

    <div id="errorModal" class="modal fade">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Error</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="errorMessage"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts: primero la variable global, luego las librerías, luego el script externo -->
    <script>
        // Datos precargados desde el servidor
        var productosData = @Html.Raw(Model.ProductosDataJson ?? "[]");
    </script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Facturas/create.js"></script>
</body>
</html>