@page
@model FactMiscelanea.Pages.Facturas.DeleteModel
@{
    ViewData["Title"] = "Eliminar Factura";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Facturas/delete.css" />
</head>
<body>
    <div class="container delete-container">
        <div class="header-delete">
            <i class="fas fa-exclamation-triangle warning-icon"></i>
            <h1>Eliminar Factura</h1>
            <p class="mb-0">¿Estás seguro de eliminar esta factura?</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model.Factura != null)
        {
            <div class="card mb-3">
                <div class="card-header bg-danger text-white">
                    Información de la factura
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Folio:</dt>
                        <dd class="col-sm-8">@Model.Factura.folio</dd>

                        <dt class="col-sm-4">Fecha:</dt>
                        <dd class="col-sm-8">@Model.Factura.fecha_hora.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Cliente:</dt>
                        <dd class="col-sm-8">@(Model.Factura.Cliente?.nombre ?? "Público General")</dd>

                        <dt class="col-sm-4">Total:</dt>
                        <dd class="col-sm-8 fw-bold text-danger">₡@Model.Factura.total_final.ToString("N2")</dd>
                    </dl>
                </div>
            </div>

            <div class="alert alert-warning">
                <strong>Atención:</strong> Esta acción no se puede deshacer. La factura será eliminada permanentemente.
            </div>

            <form method="post">
                <input type="hidden" asp-for="Factura.id_factura" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger btn-lg">
                        Sí, eliminar factura
                    </button>
                    <a href="/Facturas" class="btn btn-secondary btn-lg">
                        Cancelar
                    </a>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-warning text-center">
                Factura no encontrada
            </div>
            <div class="text-center">
                <a href="/Facturas" class="btn btn-primary">Volver a facturas</a>
            </div>
        }
    </div>
</body>
</html>