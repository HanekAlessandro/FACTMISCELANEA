@page
@model FactMiscelanea.Pages.Facturas.IndexModel
@{
    ViewData["Title"] = "Facturas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .main-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 30px;
            overflow: hidden;
        }

        .btn-facturar {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            padding: 12px 25px;
            font-weight: 600;
        }

        .btn-facturar:hover {
            transform: translateY(-2px);
        }

        /* TABLA */

        .table-responsive {
            overflow-x: auto;
            width: 100%;
        }

        .table-facturas {
            width: 100%;
            table-layout: fixed;
            border-radius: 15px;
            overflow: hidden;
        }

        .table-facturas thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .table-facturas th {
            text-align: center;
            padding: 15px;
            white-space: nowrap;
        }

        .table-facturas td {
            text-align: center;
            vertical-align: middle;
            padding: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ANCHOS COLUMNAS */

        .col-folio {
            width: 180px;
        }

        .col-fecha {
            width: 180px;
        }

        .col-cliente {
            width: 200px;
        }

        .col-total {
            width: 140px;
        }

        .col-estado {
            width: 130px;
        }

        .col-usuario {
            width: 150px;
        }

        .col-acciones {
            width: 180px;
        }

        /* BADGES */

        .badge-anulada {
            background-color: #dc3545;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        .badge-normal {
            background-color: #28a745;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
        }

        /* BOTONES */

        .btn-accion {
            margin: 2px;
        }

    </style>
</head>

<body>

    <div class="container main-card">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h1>
                <i class="fas fa-file-invoice-dollar me-3"></i>
                Gestión de Facturas
            </h1>

            <a href="/Facturas/Create"
               class="btn btn-success btn-facturar">

                <i class="fas fa-plus-circle me-2"></i>

                Nueva Factura

            </a>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                <i class="fas fa-check-circle me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <div class="table-responsive">

            <table class="table table-hover table-facturas">

                <thead>

                    <tr>

                        <th class="col-folio">
                            Folio
                        </th>

                        <th class="col-fecha">
                            Fecha
                        </th>

                        <th class="col-cliente">
                            Cliente
                        </th>

                        <th class="col-total">
                            Total
                        </th>

                        <th class="col-estado">
                            Estado
                        </th>

                        <th class="col-usuario">
                            Usuario
                        </th>

                        <th class="col-acciones">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var factura in Model.Facturas)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @factura.folio
                                </strong>
                            </td>

                            <td>
                                @factura.fecha_hora.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @(factura.Cliente?.nombre ?? "Público General")
                            </td>

                            <td>
                                ₡@factura.total_final.ToString("N2")
                            </td>

                            <td>

                                @if (factura.anulada)
                                {
                                    <span class="badge-anulada">

                                        <i class="fas fa-ban me-1"></i>

                                        Anulada

                                    </span>
                                }
                                else
                                {
                                    <span class="badge-normal">

                                        <i class="fas fa-check me-1"></i>

                                        Activa

                                    </span>
                                }

                            </td>

                            <td>
                                @(factura.Usuario?.nombre_usuario ?? "-")
                            </td>

                            <td>

                                <a href="/Facturas/Details?id=@factura.id_factura"
                                   class="btn btn-sm btn-info text-white btn-accion">

                                    <i class="fas fa-eye"></i>

                                </a>

                                @if (!factura.anulada)
                                {
                                    <a href="/Facturas/Delete?id=@factura.id_factura"
                                       class="btn btn-sm btn-danger btn-accion"
                                       onclick="return confirm('¿Anular esta factura?')">

                                        <i class="fas fa-ban"></i>

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>