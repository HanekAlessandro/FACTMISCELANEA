@page
@model FactMiscelanea.Pages.Facturas.IndexModel
@{
    ViewData["Title"] = "Facturas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Facturas/index.css" />
</head>
<body>

    <div class="container main-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Gestión de Facturas</h1>
            <a href="/Facturas/Create" class="btn btn-success btn-facturar">
                Nueva Factura
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover table-facturas">
                <thead>
                    <tr>
                        <th class="col-folio">Folio</th>
                        <th class="col-fecha">Fecha</th>
                        <th class="col-cliente">Cliente</th>
                        <th class="col-total">Total</th>
                        <th class="col-estado">Estado</th>
                        <th class="col-usuario">Usuario</th>
                        <th class="col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var factura in Model.Facturas)
                    {
                        <tr>
                            <td><strong>@factura.folio</strong></td>
                            <td>@factura.fecha_hora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(factura.Cliente?.nombre ?? "Público General")</td>
                            <td>₡@factura.total_final.ToString("N2")</td>
                            <td>
                                @if (factura.anulada)
                                {
                                    <span class="badge-anulada">Anulada</span>
                                }
                                else
                                {
                                    <span class="badge-normal">Activa</span>
                                }
                            </td>
                            <td>@(factura.Usuario?.nombre_usuario ?? "-")</td>
                            <td>
                                <a href="/Facturas/Details?id=@factura.id_factura"
                                   class="btn btn-sm btn-info text-white btn-accion">
                                    Ver
                                </a>
                                @if (!factura.anulada)
                                {
                                    <a href="/Facturas/Delete?id=@factura.id_factura"
                                       class="btn btn-sm btn-danger btn-accion"
                                       onclick="return confirm('¿Anular esta factura?')">
                                        Anular
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>